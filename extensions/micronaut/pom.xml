<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.carbonintensity</groupId>
        <artifactId>green-scheduler-extensions-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>green-scheduler-micronaut-parent</artifactId>
    <packaging>pom</packaging>
    <name>Green Scheduler - Micronaut Extension - Parent</name>

    <modules>
        <module>processor</module>
        <module>runtime</module>
    </modules>

    <properties>
        <micronaut.version>4.10.25</micronaut.version>
        <!-- Micronaut 4 requires Java 17 -->
        <maven.compiler.release>17</maven.compiler.release>
        <!--
            Only used to compile the optional Micrometer metrics wiring in the runtime module - see the comment on
            the micrometer-core dependency there for why, unlike the Quarkus extension, this version has to be
            pinned somewhere in our own reactor. Matches what micronaut-micrometer 5.13.3 (the line that imports
            micronaut-core-bom:4.10.26, the closest published match to micronaut.version above) itself pins for
            micrometer-core, so a consumer on that real Micronaut+Micrometer combination sees the exact version
            this reactor already compiles and tests against.
        -->
        <micrometer.version>1.15.12</micrometer.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.micronaut</groupId>
                <artifactId>micronaut-core-bom</artifactId>
                <version>${micronaut.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
