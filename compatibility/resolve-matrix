#!/usr/bin/env bash
set -euo pipefail

# resolve-matrix - computes the compatibility test matrix from live release data (or a recorded
# fixture) according to compatibility/policy.yaml, and prints it as JSON on stdout.
#
# Usage:
#   compatibility/resolve-matrix <required|canary|all|pr> [--fixture <dir>] [--as-of <yyyy-mm-dd>]
#
#   required   every framework/version combination in the required tier, crossed with the Java
#              versions from policy.yaml
#   canary     every combination in the canary tier, same Java axis
#   all        required + canary
#   pr         the light PR-validation subset: the pinned combination (read straight out of
#              extensions/quarkus/pom.xml, extensions/spring-boot-starter/pom.xml and
#              extensions/micronaut/pom.xml) plus the newest required line per framework, on JDK 17
#              - plus JDK 25 for the quarkus/spring-boot pinned combinations (the pinned Micronaut
#              combination instead gets its own major's Java floor, see
#              micronaut_java_floor_for_major). Always tier "required": this is the PR gate,
#              canaries never block a PR - Micronaut being entirely canary today doesn't exempt its
#              pinned combination from this check, same as the other two frameworks.
#
#   --fixture <dir>   read release data from a recorded snapshot instead of the network (see
#                     compatibility/fixtures/<date>/ for the expected file names). Meant for local
#                     development and for exercising this script without depending on the outside
#                     world. When set, --as-of defaults to the directory's basename (fixtures are
#                     named after the date they were captured), since "active" vs. "EOL" is only
#                     meaningful relative to some notion of "today".
#   --as-of <date>    override the reference date used for EOL comparisons (mostly useful together
#                     with --fixture, but also handy to sanity-check what the matrix would have
#                     looked like on a given day).
#
# Output is a single JSON object: {"include": [...]}, directly usable as a GitHub Actions
# strategy.matrix (`strategy: matrix: ${{ fromJson(needs.resolve.outputs.matrix) }}`). Each include
# entry has: framework, module, line, version, java, tier, key, label. "key" is the
# framework:line:tier identity used for issue de-duplication (see report-failure) - deliberately
# not the patch version, so a new patch of an already-tracked line doesn't open a second issue.
#
# Fails hard (rather than silently emitting an empty or too-small matrix) if fewer than 2 entries
# are produced for the requested scope - see the note in the PR description about
# needs.<job>.outputs.<x> going empty-string silently when a job is skipped; the same instinct
# applies here: a matrix generator should never fail quietly.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
POLICY_FILE="$SCRIPT_DIR/policy.yaml"

usage() {
    echo "Usage: $(basename "$0") <required|canary|all|pr> [--fixture <dir>] [--as-of <yyyy-mm-dd>]" >&2
}

SCOPE="${1:-}"
if [[ -z "$SCOPE" ]]; then
    usage
    exit 1
fi
shift

FIXTURE_DIR=""
AS_OF=""
while [[ $# -gt 0 ]]; do
    case "$1" in
    --fixture)
        FIXTURE_DIR="$2"
        shift 2
        ;;
    --as-of)
        AS_OF="$2"
        shift 2
        ;;
    *)
        echo "resolve-matrix: unknown argument '$1'" >&2
        usage
        exit 1
        ;;
    esac
done

case "$SCOPE" in
required | canary | all | pr) ;;
*)
    usage
    exit 1
    ;;
esac

need() {
    command -v "$1" >/dev/null 2>&1 || {
        echo "resolve-matrix: '$1' is required but not found on PATH" >&2
        exit 1
    }
}
need jq
need yq
if [[ -z "$FIXTURE_DIR" ]]; then
    need curl
else
    if [[ ! -d "$FIXTURE_DIR" ]]; then
        echo "resolve-matrix: fixture directory '$FIXTURE_DIR' does not exist" >&2
        exit 1
    fi
    if [[ -z "$AS_OF" ]]; then
        AS_OF="$(basename "$FIXTURE_DIR")"
    fi
fi
if [[ -z "$AS_OF" ]]; then
    AS_OF="$(date -u +%Y-%m-%d)"
fi

# ---- data access -----------------------------------------------------------------------------
# Each of these is cached to a file on first call: scope "all" resolves both the required and
# canary rule for a framework, and spring_boot_latest_clean_version_for_line is called once per
# matched line, so without caching a single run could hit the same URL two, three, or more times.
# A plain bash variable can't do this - by the time these run, they're already inside a `$(...)`
# subshell (see the "explicit if-checks" comment on pr_matrix), so anything they set in memory
# disappears with that subshell; a file is the simplest thing that actually persists across them.

CACHE_DIR="$(mktemp -d)"
trap 'rm -rf "$CACHE_DIR"' EXIT

quarkus_releases_json() {
    local cache_file="$CACHE_DIR/quarkus-releases.json"
    if [[ ! -s "$cache_file" ]]; then
        if [[ -n "$FIXTURE_DIR" ]]; then
            cat "$FIXTURE_DIR/quarkus-releases.json" >"$cache_file"
        else
            local url
            url=$(yq -r '.frameworks.quarkus.sources.releases' "$POLICY_FILE")
            curl -sf "$url" | yq -o=json '.releases' >"$cache_file"
        fi
    fi
    cat "$cache_file"
}

spring_boot_lifecycle_json() {
    local cache_file="$CACHE_DIR/spring-boot-lifecycle.json"
    if [[ ! -s "$cache_file" ]]; then
        if [[ -n "$FIXTURE_DIR" ]]; then
            cat "$FIXTURE_DIR/spring-boot-lifecycle.json" >"$cache_file"
        else
            local url
            url=$(yq -r '.frameworks.spring-boot.sources.lifecycle' "$POLICY_FILE")
            curl -sf "$url" >"$cache_file"
        fi
    fi
    cat "$cache_file"
}

spring_boot_versions_json() {
    local cache_file="$CACHE_DIR/spring-boot-versions.json"
    if [[ ! -s "$cache_file" ]]; then
        if [[ -n "$FIXTURE_DIR" ]]; then
            cat "$FIXTURE_DIR/spring-boot-versions.json" >"$cache_file"
        else
            local url
            url=$(yq -r '.frameworks.spring-boot.sources.artifact-versions' "$POLICY_FILE")
            curl -sf "$url" | yq -p=xml -o=json '.metadata.versioning.versions.version' >"$cache_file"
        fi
    fi
    cat "$cache_file"
}

# ---- policy dispatch ----------------------------------------------------------------------------
# The rule *names* in policy.yaml (frameworks.<x>.selection.<tier>) are looked up here and
# dispatched to the matching rule_* function below - this is what makes "edit policy.yaml" actually
# change what gets tested, instead of the YAML being descriptive text a bash function quietly
# ignores. An unknown rule name is a hard error, never a silent no-op, so a typo in policy.yaml
# (or a rule assigned to a framework that doesn't implement it) fails loudly right here instead of
# producing a suspiciously-empty matrix three functions away.

selection_rule() {
    # $1: framework key in policy.yaml (as it appears there, e.g. "spring-boot"), $2: tier.
    yq -r ".frameworks.\"$1\".selection.$2" "$POLICY_FILE"
}

rule_none() {
    echo "[]"
}

# ---- adapter: quarkus -------------------------------------------------------------------------

rule_active_lts_lines() {
    # Every release line marked lts:true whose eol_date hasn't passed yet.
    local tier="$1"
    quarkus_releases_json | jq -c --arg asof "$AS_OF" --arg tier "$tier" '
        [ .[]
          | select(.lts == true)
          | select((.eol_date == null) or (.eol_date > $asof))
          | {framework: "quarkus", module: "quarkus-app", line: .version, version: .latest_patch, tier: $tier}
        ]'
}

rule_latest_stable_non_lts_line() {
    # The newest non-upcoming, non-LTS line ("latest stable").
    local tier="$1"
    quarkus_releases_json | jq -c --arg tier "$tier" '
        [ .[]
          | select((.upcoming // false) == false)
          | select(.lts == false)
          | select(.latest_patch != null)
        ]
        | sort_by(.version | split(".") | map(tonumber))
        | reverse
        | .[0:1]
        | map({framework: "quarkus", module: "quarkus-app", line: .version, version: .latest_patch, tier: $tier})'
}

quarkus_entries_for_tier() {
    local tier="$1" rule
    rule="$(selection_rule quarkus "$tier")"
    case "$rule" in
    active-lts-lines) rule_active_lts_lines "$tier" ;;
    latest-stable-non-lts-line) rule_latest_stable_non_lts_line "$tier" ;;
    none) rule_none ;;
    *)
        echo "resolve-matrix: unknown selection rule '$rule' for frameworks.quarkus.selection.$tier in policy.yaml" >&2
        exit 1
        ;;
    esac
}

quarkus_required_entries() { quarkus_entries_for_tier required; }
quarkus_canary_entries() { quarkus_entries_for_tier canary; }

# ---- adapter: spring-boot ----------------------------------------------------------------------
# The lifecycle API tells us *which lines* qualify; the actual patch version to test is then
# resolved from Maven Central so we're testing what a consumer would really get, not whatever
# endoflife.date happens to have cached.

spring_boot_required_lines() {
    spring_boot_lifecycle_json | jq -c --arg asof "$AS_OF" '
        def maj: (.cycle | split(".")[0] | tonumber);
        def minr: (.cycle | split(".")[1] | tonumber);
        ( [ .[] | maj ] | max ) as $currentMajor
        | ( [ .[] | select(maj == ($currentMajor - 1)) ] | sort_by(minr) | last ) as $terminalPrevious
        | ( [ .[] | select(maj == $currentMajor) | select(.eol > $asof) ] ) as $activeCurrent
        | ($activeCurrent + (if $terminalPrevious == null then [] else [$terminalPrevious] end))
        | unique_by(.cycle)
        | map(.cycle)'
}

# Highest non-prerelease (no -M, -RC, -CR, -SNAPSHOT suffix) version on a given minor line.
spring_boot_latest_clean_version_for_line() {
    local line="$1"
    spring_boot_versions_json | jq -r --arg line "$line" '
        [ .[]
          | select(startswith($line + "."))
          | select(test("^[0-9]+\\.[0-9]+\\.[0-9]+$"))
        ]
        | sort_by(split(".") | map(tonumber))
        | last // empty'
}

rule_active_current_major_lines_plus_terminal_previous_major() {
    local tier="$1"
    local lines line version entries="[]"
    lines=$(spring_boot_required_lines)
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        version=$(spring_boot_latest_clean_version_for_line "$line")
        if [[ -z "$version" ]]; then
            echo "resolve-matrix: no published non-prerelease version found for spring-boot line '$line'" >&2
            exit 1
        fi
        entries=$(jq -c --arg line "$line" --arg version "$version" --arg tier "$tier" \
            '. + [{framework: "spring-boot", module: "spring-boot-app", line: $line, version: $version, tier: $tier}]' \
            <<<"$entries")
    done < <(jq -r '.[]' <<<"$lines")
    echo "$entries"
}

spring_boot_entries_for_tier() {
    local tier="$1" rule
    rule="$(selection_rule spring-boot "$tier")"
    case "$rule" in
    active-current-major-lines-plus-terminal-previous-major)
        rule_active_current_major_lines_plus_terminal_previous_major "$tier"
        ;;
    none) rule_none ;;
    *)
        echo "resolve-matrix: unknown selection rule '$rule' for frameworks.spring-boot.selection.$tier in policy.yaml" >&2
        exit 1
        ;;
    esac
}

spring_boot_required_entries() { spring_boot_entries_for_tier required; }
spring_boot_canary_entries() { spring_boot_entries_for_tier canary; }

# ---- adapter: micronaut --------------------------------------------------------------------------
# Micronaut has no LTS lines; support is major-version-based (see the ADR), so the selection rule is
# "current major + previous major" rather than an LTS filter. It also has no single Java axis it
# crosses cleanly against: Micronaut 5 has a hard floor of Java 25, Micronaut 4 tops out at the
# baseline Java 17 this repo otherwise assumes for everything else. So, unlike the other two
# adapters, this one resolves its own "java" per entry up front - with_java_axis() below is taught
# to leave such an entry alone instead of crossing it against every java-versions entry in
# policy.yaml.

micronaut_lifecycle_json() {
    local cache_file="$CACHE_DIR/micronaut-lifecycle.json"
    if [[ ! -s "$cache_file" ]]; then
        if [[ -n "$FIXTURE_DIR" ]]; then
            cat "$FIXTURE_DIR/micronaut-lifecycle.json" >"$cache_file"
        else
            local url
            url=$(yq -r '.frameworks.micronaut.sources.lifecycle' "$POLICY_FILE")
            curl -sf "$url" >"$cache_file"
        fi
    fi
    cat "$cache_file"
}

micronaut_versions_json() {
    local cache_file="$CACHE_DIR/micronaut-versions.json"
    if [[ ! -s "$cache_file" ]]; then
        if [[ -n "$FIXTURE_DIR" ]]; then
            cat "$FIXTURE_DIR/micronaut-versions.json" >"$cache_file"
        else
            local url
            url=$(yq -r '.frameworks.micronaut.sources.artifact-versions' "$POLICY_FILE")
            curl -sf "$url" | yq -p=xml -o=json '.metadata.versioning.versions.version' >"$cache_file"
        fi
    fi
    cat "$cache_file"
}

# Highest non-prerelease version for a given major. Micronaut marks pre-releases with a dotted
# qualifier (e.g. "5.2.0.RC1", "4.1.0.M1"), never a hyphen, so a plain 3-numeric-part match already
# excludes them - same idea as spring_boot_latest_clean_version_for_line above.
micronaut_latest_clean_version_for_major() {
    local major="$1"
    micronaut_versions_json | jq -r --arg major "$major" '
        [ .[]
          | select(startswith($major + "."))
          | select(test("^[0-9]+\\.[0-9]+\\.[0-9]+$"))
        ]
        | sort_by(split(".") | map(tonumber))
        | last // empty'
}

# Java floor per major - not derivable from either source feed (Micronaut's endoflife.date entries
# carry no "supportedJavaVersions" field the way Spring Boot's do), so it's recorded here per the
# ADR's own note. Update this table - and re-read the ADR - if Micronaut 6 ever ships.
micronaut_java_floor_for_major() {
    case "$1" in
    4) echo 17 ;;
    5) echo 25 ;;
    *)
        echo "resolve-matrix: no known Java floor for micronaut major '$1' - update micronaut_java_floor_for_major" >&2
        exit 1
        ;;
    esac
}

rule_active_current_and_previous_major() {
    local tier="$1"
    local majors current previous major version java entries="[]"
    majors=$(micronaut_lifecycle_json | jq -c '[ .[] | .cycle | select(test("^[0-9]+$")) | tonumber ] | sort | reverse')
    current=$(jq -r '.[0]' <<<"$majors")
    previous=$(jq -r '.[1] // empty' <<<"$majors")
    for major in "$current" "$previous"; do
        [[ -z "$major" ]] && continue
        version=$(micronaut_latest_clean_version_for_major "$major")
        if [[ -z "$version" ]]; then
            echo "resolve-matrix: no published non-prerelease version found for micronaut major '$major'" >&2
            exit 1
        fi
        java=$(micronaut_java_floor_for_major "$major")
        entries=$(jq -c --arg line "$major" --arg version "$version" --arg tier "$tier" --argjson java "$java" \
            '. + [{framework: "micronaut", module: "micronaut-app", line: $line, version: $version, tier: $tier, java: $java}]' \
            <<<"$entries")
    done
    echo "$entries"
}

micronaut_entries_for_tier() {
    local tier="$1" rule
    rule="$(selection_rule micronaut "$tier")"
    case "$rule" in
    active-current-and-previous-major) rule_active_current_and_previous_major "$tier" ;;
    none) rule_none ;;
    *)
        echo "resolve-matrix: unknown selection rule '$rule' for frameworks.micronaut.selection.$tier in policy.yaml" >&2
        exit 1
        ;;
    esac
}

micronaut_required_entries() { micronaut_entries_for_tier required; }
micronaut_canary_entries() { micronaut_entries_for_tier canary; }

# ---- assembly -----------------------------------------------------------------------------------

java_versions_json() {
    yq -o=json '.java-versions' "$POLICY_FILE"
}

with_java_axis() {
    # Crosses an array of {framework, module, line, version, tier} entries with the Java versions,
    # and fills in the derived "key" and "label" fields. An entry that already carries its own
    # "java" (the micronaut adapter does this, since it can't share one Java axis across majors) is
    # left as-is instead of being crossed again - it just gets "key"/"label" filled in.
    local entries="$1"
    local javas
    javas=$(java_versions_json)
    jq -c --argjson javas "$javas" '
        [ .[] as $e |
            if ($e | has("java")) then
                $e + {
                    key: ($e.framework + ":" + $e.line + ":" + $e.tier),
                    label: ($e.framework + " " + $e.version + " (JDK " + ($e.java | tostring) + ", " + $e.tier + ")")
                }
            else
                $javas[] as $java
                | $e + {
                    java: $java,
                    key: ($e.framework + ":" + $e.line + ":" + $e.tier),
                    label: ($e.framework + " " + $e.version + " (JDK " + ($java | tostring) + ", " + $e.tier + ")")
                }
            end
        ]' <<<"$entries"
}

pinned_version() {
    # $1: pom.xml path, $2: property name (e.g. quarkus.version)
    grep -m1 -oE "<${2//./\\.}>[^<]+</${2//./\\.}>" "$1" | sed -E 's/<[^>]+>//g'
}

pr_matrix() {
    local q_pinned sb_pinned m_pinned q_line sb_line m_line m_java
    q_pinned=$(pinned_version "$REPO_ROOT/extensions/quarkus/pom.xml" "quarkus.version")
    sb_pinned=$(pinned_version "$REPO_ROOT/extensions/spring-boot-starter/pom.xml" "spring.boot.version")
    m_pinned=$(pinned_version "$REPO_ROOT/extensions/micronaut/pom.xml" "micronaut.version")
    if [[ -z "$q_pinned" || -z "$sb_pinned" || -z "$m_pinned" ]]; then
        echo "resolve-matrix: could not read pinned quarkus/spring-boot/micronaut version from the extension poms" >&2
        exit 1
    fi
    q_line=$(cut -d. -f1,2 <<<"$q_pinned")
    sb_line=$(cut -d. -f1,2 <<<"$sb_pinned")
    # Micronaut lines are single-number majors, not major.minor.
    m_line=$(cut -d. -f1 <<<"$m_pinned")
    m_java=$(micronaut_java_floor_for_major "$m_line")

    # All required lines, not just the newest: a regression that only breaks e.g. Quarkus 3.27
    # (while 3.33 stays fine) would otherwise slip through the PR check entirely and only surface
    # a week later from the scheduled monitor, instead of blocking the PR that caused it. Each
    # required line is tested once, at the baseline Java version; the pinned combination below
    # additionally gets the latest Java version too, since it's the one thing every PR builds from
    # source anyway and the extra JDK coverage there is cheap.
    # Explicit if-checks, not bare assignments: pr_matrix is itself invoked as
    # MATRIX_ENTRIES="$(pr_matrix)", so these are a *nested* command substitution - bash's `set -e`
    # does not reliably abort on a failing `var=$(cmd)` once already inside a subshell like that
    # (confirmed empirically; `shopt -s inherit_errexit` fixes it but needs bash 4.4+, which this
    # script can't assume for local runs). Without the explicit check, an unknown selection rule
    # would silently produce an empty q_required/sb_required instead of stopping the script.
    local q_required sb_required m_required
    if ! q_required=$(quarkus_required_entries); then
        exit 1
    fi
    if ! sb_required=$(spring_boot_required_entries); then
        exit 1
    fi
    if ! m_required=$(micronaut_required_entries); then
        exit 1
    fi

    # Baseline/latest Java versions come from the same policy.yaml list every other scope crosses
    # against - not separate literals here, so bumping java-versions in one place (e.g. dropping
    # 17, or moving to 21/25) actually changes the PR check too, instead of only the scheduled one.
    local javas baseline_java latest_java
    javas=$(java_versions_json)
    baseline_java=$(jq 'min' <<<"$javas")
    latest_java=$(jq 'max' <<<"$javas")

    local q_required_baseline sb_required_baseline m_required_baseline
    q_required_baseline=$(jq -c --argjson j "$baseline_java" 'map(. + {java: $j})' <<<"$q_required")
    sb_required_baseline=$(jq -c --argjson j "$baseline_java" 'map(. + {java: $j})' <<<"$sb_required")
    # m_required is empty today (required: none in policy.yaml until Micronaut is promoted), but
    # resolved the same way as the other two so this keeps working unchanged once it isn't.
    m_required_baseline=$(jq -c --argjson j "$baseline_java" 'map(. + {java: $j})' <<<"$m_required")

    # The pinned Micronaut combination gets only its own major's Java floor here, not the
    # baseline+latest pair quarkus/spring-boot get - we have no basis for claiming Micronaut 4 runs
    # on JDK 25 or Micronaut 5 on JDK 17, so testing outside a major's floor would assert something
    # nobody has verified. See micronaut_java_floor_for_major above.
    jq -n -c \
        --arg qLine "$q_line" --arg qVersion "$q_pinned" \
        --arg sbLine "$sb_line" --arg sbVersion "$sb_pinned" \
        --arg mLine "$m_line" --arg mVersion "$m_pinned" --argjson mJava "$m_java" \
        --argjson qRequiredBaseline "$q_required_baseline" --argjson sbRequiredBaseline "$sb_required_baseline" \
        --argjson mRequiredBaseline "$m_required_baseline" \
        --argjson baselineJava "$baseline_java" --argjson latestJava "$latest_java" '
        (
          [
            {framework: "quarkus", module: "quarkus-app", line: $qLine, version: $qVersion, tier: "required", java: $baselineJava},
            {framework: "quarkus", module: "quarkus-app", line: $qLine, version: $qVersion, tier: "required", java: $latestJava},
            {framework: "spring-boot", module: "spring-boot-app", line: $sbLine, version: $sbVersion, tier: "required", java: $baselineJava},
            {framework: "spring-boot", module: "spring-boot-app", line: $sbLine, version: $sbVersion, tier: "required", java: $latestJava},
            {framework: "micronaut", module: "micronaut-app", line: $mLine, version: $mVersion, tier: "required", java: $mJava}
          ]
          + $qRequiredBaseline + $sbRequiredBaseline + $mRequiredBaseline
        )
        | map(. + {key: (.framework + ":" + .line + ":" + .tier), label: (.framework + " " + .version + " (JDK " + (.java|tostring) + ", " + .tier + ")")})
        | unique_by([.framework, .version, .java])'
}

# Each rule call below is deliberately its own bare `var=$(...)` assignment, never fed straight
# into a pipeline or a `<(...)` process substitution: a rule that hits the "unknown selection
# rule" exit 1 (see quarkus_entries_for_tier/spring_boot_entries_for_tier) needs `set -e` to
# actually see that failure and abort. Process substitution exit codes are invisible to `set -e` -
# feeding rule output straight into `jq -s add <(...) <(...)` let a failed rule silently vanish
# into an incomplete-but-still-"successful" matrix instead of stopping the script, exactly the
# quiet-failure this script exists to refuse elsewhere.
case "$SCOPE" in
pr)
    MATRIX_ENTRIES="$(pr_matrix)"
    ;;
required)
    Q_ENTRIES="$(quarkus_required_entries)"
    SB_ENTRIES="$(spring_boot_required_entries)"
    M_ENTRIES="$(micronaut_required_entries)"
    MATRIX_ENTRIES="$(with_java_axis "$(jq -c -n --argjson a "$Q_ENTRIES" --argjson b "$SB_ENTRIES" --argjson c "$M_ENTRIES" '$a + $b + $c')")"
    ;;
canary)
    Q_ENTRIES="$(quarkus_canary_entries)"
    SB_ENTRIES="$(spring_boot_canary_entries)"
    M_ENTRIES="$(micronaut_canary_entries)"
    MATRIX_ENTRIES="$(with_java_axis "$(jq -c -n --argjson a "$Q_ENTRIES" --argjson b "$SB_ENTRIES" --argjson c "$M_ENTRIES" '$a + $b + $c')")"
    ;;
all)
    Q_REQUIRED="$(quarkus_required_entries)"
    SB_REQUIRED="$(spring_boot_required_entries)"
    M_REQUIRED="$(micronaut_required_entries)"
    Q_CANARY="$(quarkus_canary_entries)"
    SB_CANARY="$(spring_boot_canary_entries)"
    M_CANARY="$(micronaut_canary_entries)"
    MATRIX_ENTRIES="$(with_java_axis "$(jq -c -n \
        --argjson a "$Q_REQUIRED" --argjson b "$SB_REQUIRED" --argjson c "$Q_CANARY" --argjson d "$SB_CANARY" \
        --argjson e "$M_REQUIRED" --argjson f "$M_CANARY" \
        '$a + $b + $c + $d + $e + $f')")"
    ;;
esac

COUNT=$(jq 'length' <<<"$MATRIX_ENTRIES")
if [[ "$COUNT" -lt 2 ]]; then
    echo "resolve-matrix: refusing to emit a matrix with fewer than 2 entries (got $COUNT) for scope '$SCOPE' as-of '$AS_OF'" >&2
    exit 1
fi

jq -c -n --argjson matrixEntries "$MATRIX_ENTRIES" '{"include": $matrixEntries}'
